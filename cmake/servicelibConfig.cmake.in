@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL)
if(@SERVICELIB_ENABLE_CRON@)
  find_dependency(userver CONFIG COMPONENTS core)
  find_dependency(libcron CONFIG)
endif()
if(@SERVICELIB_ENABLE_NATS@)
  find_dependency(userver CONFIG COMPONENTS core)
  find_dependency(cnats 3.14.0 CONFIG)
endif()
if(@SERVICELIB_ENABLE_PULSAR@)
  find_dependency(userver CONFIG COMPONENTS core)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(PulsarNative 4.2.0 EXACT)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/servicelibTargets.cmake")
check_required_components(servicelib)
