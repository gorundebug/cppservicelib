{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SERVICELIB_BUILD_TESTS": "ON",
        "SERVICELIB_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "docker",
      "generator": "Ninja",
      "binaryDir": "/workspace/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SERVICELIB_BUILD_TESTS": "ON",
        "SERVICELIB_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "docker",
      "configurePreset": "docker"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "docker",
      "configurePreset": "docker",
      "output": {"outputOnFailure": true}
    }
  ]
}
